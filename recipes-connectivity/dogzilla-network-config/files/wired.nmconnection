[connection]
id=wired
uuid=d09b1e00-d060-4a11-a000-000000000001
type=ethernet
autoconnect=true
autoconnect-priority=0

[ipv4]
method=auto
# Fall back to link-local (169.254.x) if no DHCP server answers, so a cable run
# straight to a laptop still gets an address. With avahi the robot is then
# reachable at <hostname>.local (e.g. dogzilla.local) with no config either end.
link-local=fallback

[ipv6]
method=auto
addr-gen-mode=default
