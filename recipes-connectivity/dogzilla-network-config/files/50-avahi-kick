#!/bin/sh
# networkd-dispatcher hook (see /etc/networkd-dispatcher/{routable,degraded}.d):
# avahi-daemon's netlink monitor is supposed to pick up address changes on its
# own, but on this image it doesn't reliably re-announce after eth0 gets a new
# address (DHCP lease replacing the IPv4LL fallback, or a fresh lease after a
# replug) -- so kick it explicitly instead of waiting for a client's mDNS cache
# to expire and get retried.
[ "$IFACE" = "eth0" ] || exit 0
systemctl try-restart avahi-daemon.service
